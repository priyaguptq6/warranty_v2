# Railway / local environment variables for warranty_v2
# Do NOT commit your real secrets to GitHub.

# Firebase service account JSON as a single environment variable.
# Paste the entire JSON content here with quotes escaped if required.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional alternative: path to a JSON file on your server/container.
# FIREBASE_SERVICE_ACCOUNT=/path/to/service-account.json

# Anthropic API key for AI image extraction (optional but recommended).
ANTHROPIC_API_KEY=

# Host and port for local/testing deployment.
HOST=0.0.0.0
PORT=5000
