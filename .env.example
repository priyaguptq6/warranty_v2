################################################################################
# MUDIT COMPUTERS - WARRANTY SYSTEM v2
# Environment Configuration for Local Development & Heroku Deployment
# Do NOT commit your real secrets to GitHub (.env is in .gitignore)
################################################################################

# ─ FLASK CONFIGURATION ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
FLASK_ENV=production
FLASK_DEBUG=False

# ─ FIREBASE CONFIGURATION ──────────────────────────────────────────────────
# Option 1: Firebase Service Account JSON (Recommended for Heroku)
# Get from: Firebase Console > Project Settings > Service Accounts > Generate Key
# Paste the ENTIRE JSON content as a single-line string with escaped quotes
# Example: {"type":"service_account","project_id":"xxx",...}
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 2: Path to local Firebase service account JSON file (for local development)
# FIREBASE_SERVICE_ACCOUNT=/path/to/serviceAccountKey.json

# ─ AI/ANTHROPIC CONFIGURATION (Optional) ───────────────────────────────────
# Get from: https://console.anthropic.com/
# Used for automatic device image analysis and damage detection
ANTHROPIC_API_KEY=

# ─ EMAIL/SMTP CONFIGURATION (Optional) ─────────────────────────────────────
# Gmail App Password for sending customer notifications
# Get from: Google Account > Security > 2-Step Verification > App Passwords
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# ─ SHOP DETAILS (Used in notifications) ───────────────────────────────────
SHOP_NAME=MUDIT COMPUTERS
SHOP_PHONE=+91-XXXXXXXXXX
